# =============================================================================
# Chronos Blockchain — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.
# =============================================================================

# Private key of the deployer wallet (without 0x prefix is also fine; with 0x is OK).
# Fund this account with Amoy POL from a faucet before deploying.
# 64-char hex private key (with or without 0x). Leave unset for local-only work.
PRIVATE_KEY=

# Polygon Amoy Testnet RPC URL
# Public default: https://rpc-amoy.polygon.technology
# For production reliability, prefer a provider (Alchemy, Infura, QuickNode, etc.)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Polygonscan API key (optional) — used for contract verification on Amoy
# Get one at: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
