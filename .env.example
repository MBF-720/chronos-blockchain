# =============================================================================
# Chronos Blockchain — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.
# =============================================================================

# Polygon Amoy RPC (Alchemy, Infura, QuickNode, or public RPC)
RPC_URL=https://rpc-amoy.polygon.technology

# Administrator wallet private key (64 hex chars, with or without 0x)
PRIVATE_KEY=

# Administrator wallet address (must match PRIVATE_KEY)
ADMIN_WALLET=

# Polygon Amoy Chain ID
CHAIN_ID=80002

# Filled after ChronosToken deployment
TOKEN_ADDRESS=

# Optional — contract verification on Polygonscan
POLYGONSCAN_API_KEY=
